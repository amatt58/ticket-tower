# ── Database (local Docker Postgres) ─────────────────────────────────
# Local dev always points at the Docker Postgres container:
#   docker compose up -d
# These values match docker-compose.yml, so they work as-is — nothing
# to fill in here for local dev.
#
# Neon is used ONLY for Vercel Preview/Production. Those connection
# strings are set directly in the Vercel dashboard's env config —
# never put a Neon URL in this file or commit one anywhere. See
# docs/adr/adr-006-deployment-strategy.md for the full env var map.

DIRECT_URL="postgresql://ticket_tower:ticket_tower_dev@localhost:5432/ticket_tower"
DATABASE_URL="postgresql://ticket_tower:ticket_tower_dev@localhost:5432/ticket_tower"

# ── Auth.js v5 ────────────────────────────────────────────────────────
# This secret is for LOCAL DEV ONLY — do not reuse it in Vercel.
# Production and Preview each need their OWN distinct AUTH_SECRET,
# added by hand in the Vercel dashboard (never pasted from this file).
# Generate a new one anytime with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# AUTH_URL is deliberately NOT set here — Auth.js auto-detects the
# correct URL from each request locally. Do not add it. In Vercel it
# should ONLY exist for Production (never Preview — every preview
# deployment has a different URL, so a fixed value breaks all of them).

# ── AI provider (server/ai) ───────────────────────────────────────────
# Local dev uses Ollama running natively — no API keys needed:
#   ollama pull llama3.2 && ollama pull nomic-embed-text && ollama serve
# Production sets AI_PROVIDER=openai and OPENAI_API_KEY in Vercel.
# AI_MODEL / EMBEDDING_MODEL are optional; each provider has defaults
# (ollama: llama3.2 + nomic-embed-text, openai: gpt-4o-mini +
# text-embedding-3-small). Anthropic is completion-only (no embeddings).
AI_PROVIDER="ollama"            # ollama | openai | anthropic
OLLAMA_BASE_URL="http://localhost:11434"
# AI_MODEL=""
# EMBEDDING_MODEL=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
